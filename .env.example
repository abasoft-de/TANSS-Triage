# Vorlage für .env - Secrets für TANSS-Triage.
#
# Einrichten:
#   cp .env.example .env
#   nano .env            # Werte eintragen
#   chmod 600 .env       # (Linux)
#
# Die .env liegt neben dem Programm und wird beim Start geladen. Auf dem
# Server liest sie zusätzlich systemd (EnvironmentFile), damit auch ein
# manueller Aufruf und der Dienst dieselben Werte sehen.

# --- TANSS REST-API -------------------------------------------------------
TANSS_BASE_URL=https://tanss.abasoft.de
TANSS_USERNAME=
TANSS_PASSWORD=

# --- LLM (optional) -------------------------------------------------------
# Claude-API: nur den Key eintragen, Provider "anthropic" ist dann Default.
ANTHROPIC_API_KEY=

# Nur für provider = "openai_compatible" (lokales Modell): API-Key des
# Endpunkts, falls er einen verlangt (Ollama z. B. braucht keinen).
LLM_API_KEY=
